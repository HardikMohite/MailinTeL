# ==============================================================================
# MailIntel - Environment Configuration Template
# ==============================================================================

# Application Context
APP_NAME=MailinteL
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE-ME-generate-a-long-random-value-before-any-real-use

# Auth / JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12
# Defaults to False in code (MVP-06 fix) — public self-signup immediately grants a new
# organization admin. Only set this True for a deliberately disposable local/demo
# environment, and set it back to False (or omit it) once orgs/users are provisioned.
ALLOW_SELF_SIGNUP=True
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Server Configuration
# Keep this at 127.0.0.1 for local dev — Settings.validate_production_safety()
# (app/core/config.py) hard-fails at startup if the app is network-reachable
# (BACKEND_HOST != 127.0.0.1/localhost/::1) while these are still dev-grade
# defaults (SECRET_KEY/DEBUG/POSTGRES_PASSWORD/MINIO_*). Only widen this once
# you've also replaced those defaults with real values.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins allowed to call the API from a browser (production domains, etc.)
ALLOWED_ORIGINS=

# ==============================================================================
# Database (Supabase PostgreSQL + pgvector / Local)
# ==============================================================================
# In Supabase Dashboard: Go to Project Settings -> Database -> Connection string
# MailinteL automatically sanitizes URLs: driver scheme (postgresql+asyncpg://),
# SSL enforcement (ssl="require"), and pooler caching are all handled automatically.
#
# Option 1: Supabase Direct Connection (Recommended for backend servers):
# Replace [YOUR-PASSWORD] and [PROJECT-REF] with your Supabase credentials:
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Alternatively, configure individual host parameters:
POSTGRES_HOST=db.[PROJECT-REF].supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR-PASSWORD]
POSTGRES_DB=postgres
POSTGRES_SSL=True

# Option 2: Supabase Connection Pooler (For serverless environments or port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Option 3: Local PostgreSQL (Default for local docker-compose development):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mailintel

# ==============================================================================
# Object Storage (Supabase Storage / MinIO)
# ==============================================================================
# Provider selection: 'supabase' or 'minio'
STORAGE_PROVIDER=supabase

# Supabase Storage Configuration (Active when STORAGE_PROVIDER=supabase)
# 1. Obtain Project URL and Service Role Key from Supabase Dashboard -> Project Settings -> API
# 2. Buckets MUST be created as Private buckets in Supabase Dashboard (Storage -> New Bucket)
#    or auto-provisioned using: python backend\scripts\setup_supabase_storage.py
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# Universal Storage Buckets (Used by both Supabase Storage and MinIO)
# NOTE: All buckets MUST be Private for evidence preservation integrity and multi-tenant security
STORAGE_EVIDENCE_BUCKET=mailintel-evidence
STORAGE_DERIVED_BUCKET=mailintel-derived
STORAGE_REPORTS_BUCKET=mailintel-reports
STORAGE_TEMP_BUCKET=mailintel-temp

# MinIO (Alternative local development object storage when STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=False
MINIO_EVIDENCE_BUCKET=mailintel-evidence
MINIO_DERIVED_BUCKET=mailintel-derived
MINIO_REPORTS_BUCKET=mailintel-reports
MINIO_TEMP_BUCKET=mailintel-temp

# Redis (Job Queue, Rate Limiting & Ephemeral Cache)
# Local:   redis://localhost:6379/0
# Upstash: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=False
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Initial Administrator Account
# ==============================================================================
# Automatically provisioned on server startup if not already existing
ADMIN_EMAIL=admin@mailintel.local
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_FULL_NAME=Administrator
ADMIN_ORG_NAME=MailIntel Security Operations

# Threat Intelligence & Infrastructure
# MaxMind GeoIP / ASN database (.mmdb). Supports relative path (data/GeoLite2-ASN.mmdb),
# absolute path, or Docker mount volume (/app/data/GeoLite2-ASN.mmdb)
MAXMIND_GEOIP_DB_PATH=data/GeoLite2-ASN.mmdb
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
IP_INTEL_CACHE_TTL_SECONDS=86400
ENABLE_LIVE_DNSBL_LOOKUPS=False
TOR_EXIT_LIST_URL=https://check.torproject.org/torbulkexitlist

# AI & RAG Intelligence (Groq API)
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
